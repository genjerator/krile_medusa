# Caddy reverse proxy for the Strato VPS.
# Automatic HTTPS: Caddy issues + renews Let's Encrypt certs for every hostname
# below (ports 80/443 must be reachable and DNS must point at the VPS).
# Upstreams are the docker-compose service names on the internal network.
{
	# Email used for the Let's Encrypt account / expiry notices.
	email e.medjesi@gmail.com
}

# Reusable access-log block. Writes one JSON line per request to a file that is
# bind-mounted to ./logs/caddy on the host (see docker-compose.strato.yml).
# `import access_log` into a site to log every request it serves.
(access_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MB
			roll_keep 10
		}
		format json
	}
}

# Discreet migration marker. Adds a response header proving the request was
# answered by THIS (Strato) Caddy and not the old AWS stack. Invisible to normal
# visitors — visible only in devtools/curl. Check (even before the DNS switch):
#   curl -sI --resolve www.planeta.de:443:217.154.144.21 https://www.planeta.de | grep -i x-served-by
# Remove this snippet and its `import marker` lines once the migration is verified.
(marker) {
	header +X-Served-By "strato-vps"
}

# Baseline security response headers, added to every site via `import
# security_headers`. No performance cost.
# - HSTS: tell browsers to always use HTTPS for a year, incl. subdomains (every
#   host here is served over HTTPS by Caddy). `preload` is intentionally omitted
#   (it's a hard, hard-to-undo commitment that requires list submission).
# - X-Content-Type-Options: stop browsers MIME-sniffing responses.
# - Referrer-Policy: only send the origin (not the full URL) on cross-site requests.
# - X-Frame-Options: block other origins from framing our pages (clickjacking).
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}
}

# ══════════════════════════════════════════════════════════════════════════════
# PRODUCTION — real domains
# ══════════════════════════════════════════════════════════════════════════════

# ─── Admin + Medusa backend ──────────────────────────────────────────────────
admin.planetaindustries.de {
	import access_log
	import security_headers
	import marker
	# Browsers without an "lng" cookie get a permanent German one, so the
	# admin language survives cleared site data / closed browsers.
	@noLng not header Cookie *lng=*
	header @noLng Set-Cookie "lng=de; Path=/; Max-Age=31536000; SameSite=Lax"
	reverse_proxy medusa:9000
}

# ─── Krile / Planeta Industries storefront (canonical: www) ──────────────────
www.planetaindustries.de {
	import access_log
	import security_headers
	import marker
	reverse_proxy storefront-planeta-industries:8000
}
# apex → www
planetaindustries.de {
	import access_log
	import security_headers
	redir https://www.planetaindustries.de{uri} permanent
}

# ─── Planeta GmbH storefront (canonical: www.planeta.de) ─────────────────────
www.planeta.de {
	import access_log
	import security_headers
	import marker
	reverse_proxy storefront-planeta:8000
}
# apex + legacy planeta-shop.de (and its www) → www.planeta.de
planeta.de, planeta-shop.de, www.planeta-shop.de {
	import access_log
	import security_headers
	redir https://www.planeta.de{uri} permanent
}

