# --- Better Auth (customer login: email + Google + Facebook) ---
# Public URL of THIS backend, where Better Auth is mounted (/better-auth/*).
# Used to build OAuth callback URLs. Local dev can leave it unset (defaults to
# http://localhost:9000). Prod example: https://api.planeta-shop.de
BETTER_AUTH_URL=
# Signing secret for Better Auth sessions. Falls back to JWT_SECRET if unset.
BETTER_AUTH_SECRET=
# Comma-separated storefront origins allowed to start the login flow,
# e.g. https://planeta-shop.de,http://localhost:8000
BETTER_AUTH_TRUSTED_ORIGINS=
# OAuth app credentials. Each provider is only enabled when BOTH vars are set.
# Google callback to register:   <BETTER_AUTH_URL>/better-auth/callback/google
# Facebook callback to register: <BETTER_AUTH_URL>/better-auth/callback/facebook
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
